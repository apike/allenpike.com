{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "allenpike-com",
  "account_id": "1f4290822d583118b736835b38b400ab",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [],
  "main": "cloudflare/r2-worker.mjs",
  "compatibility_date": "2026-04-26",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Only oversized R2 media needs Worker code; serve other assets directly.
    "run_worker_first": [
      "/images/2026/voice-in-demo.m4v",
      "/slides/MappingtheInternet_SecondConf2013.pdf"
    ]
  },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "allenpike-com-media" }
  ],
  "previews": {
    "r2_buckets": [
      { "binding": "MEDIA", "bucket_name": "allenpike-com-media" }
    ]
  }
}
