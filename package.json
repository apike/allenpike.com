{
  "name": "allenpike-com",
  "version": "2.0.0",
  "description": "Allen Pike's personal website",
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy --serve",
    "clean": "rm -rf _site",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "dev:cloudflare": "pnpm run build:cloudflare && wrangler dev",
    "deploy:cloudflare": "pnpm run build:cloudflare && node scripts/deploy-cloudflare.mjs deploy",
    "preview:cloudflare": "pnpm run build:cloudflare && node scripts/deploy-cloudflare.mjs preview",
    "test:cloudflare": "node --test cloudflare/*.test.mjs",
    "test:hosting": "node scripts/test-hosting.mjs",
    "check:cloudflare-media": "node scripts/check-cloudflare-media.mjs",
    "check:cloudflare-feeds": "node scripts/check-cloudflare-feeds.mjs",
    "check:cloudflare-history": "node scripts/check-cloudflare-history.mjs",
    "ci:cloudflare": "pnpm run test:cloudflare && pnpm run build && pnpm run build:cloudflare && pnpm run check:cloudflare-feeds",
    "upload:cloudflare-media": "node scripts/upload-cloudflare-media.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "js-yaml": "^4.1.1",
    "linkedom": "^0.18.12",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-footnote": "^4.0.0",
    "smartquotes": "^2.3.2"
  },
  "devDependencies": {
    "miniflare": "4.20260730.0",
    "wrangler": "4.160.1"
  },
  "packageManager": "pnpm@10.32.1"
}
