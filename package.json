{
  "name": "allenpike-com",
  "version": "2.0.0",
  "description": "Allen Pike's personal website",
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy --serve",
    "clean": "rm -rf _site",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "test:cloudflare": "node --test cloudflare/*.test.mjs",
    "check:cloudflare-feeds": "node scripts/check-cloudflare-feeds.mjs",
    "ci:cloudflare": "npm run test:cloudflare && npm run build && npm run build:cloudflare && npm run check:cloudflare-feeds",
    "upload:cloudflare-media": "node scripts/upload-cloudflare-media.mjs"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "js-yaml": "^4.1.1",
    "linkedom": "^0.18.12",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-footnote": "^4.0.0",
    "smartquotes": "^2.3.2"
  },
  "devDependencies": {
    "miniflare": "4.20260426.0",
    "wrangler": "4.86.0"
  }
}
