{
  "name": "allenpike-com",
  "version": "2.0.0",
  "description": "Allen Pike's personal website",
  "scripts": {
    "build": "node cloudflare/deploy/build.mjs",
    "dev": "eleventy --serve",
    "clean": "rm -rf _site",
    "build:cloudflare": "pnpm run build",
    "dev:cloudflare": "pnpm run build && wrangler dev",
    "deploy:cloudflare": "pnpm run build && node cloudflare/deploy/deploy.mjs deploy",
    "preview:cloudflare": "pnpm run build && node cloudflare/deploy/deploy.mjs preview",
    "test:cloudflare": "node --test cloudflare/tests/*.test.mjs",
    "test:hosting": "node cloudflare/tests/hosting.mjs",
    "check:cloudflare-feeds": "node cloudflare/tests/feeds.mjs",
    "upload:cloudflare-media": "node cloudflare/deploy/upload-r2.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "js-yaml": "^4.1.1",
    "linkedom": "^0.18.12",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-footnote": "^4.0.0",
    "smartquotes": "^2.3.2"
  },
  "devDependencies": {
    "miniflare": "4.20260730.0",
    "wrangler": "4.160.1"
  },
  "packageManager": "pnpm@10.32.1"
}
